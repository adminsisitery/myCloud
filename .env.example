# Copy to .env on the deployment host. Supply your EXISTING cloud-drive services.
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/mycloud?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=mycloud
SPRING_DATASOURCE_PASSWORD=replace-me
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-me
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_USERNAME=mycloud
SPRING_RABBITMQ_PASSWORD=replace-me
SPRING_RABBITMQ_VIRTUAL_HOST=/
PGVECTOR_HOST=postgres
PGVECTOR_PORT=5432
PGVECTOR_DATABASE=mycloud
PGVECTOR_USER=mycloud
PGVECTOR_PASSWORD=replace-me
PGVECTOR_TABLE=file_segment
AI_API_KEY=replace-me
AI_MODEL=deepseek-chat
AI_BASE_URL=https://api.deepseek.com
AI_EMBEDDING_API_KEY=replace-me
AI_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_EMBEDDING_MODEL=text-embedding-v4
AI_EMBEDDING_DIMENSIONS=1536
AI_WEB_SEARCH_ENABLED=false
AI_TAVILY_API_KEY=
OSS_ACCESS_KEY_ID=replace-me
OSS_ACCESS_KEY_SECRET=replace-me
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_CDN_ENDPOINT=https://your-cdn.example.com
OSS_BUCKET_NAME=replace-me
OSS_STS_ROLE_ARN=replace-me
SPRING_MAIL_USERNAME=replace-me
SPRING_MAIL_PASSWORD=replace-me
OAUTH_GITHUB_CLIENT_ID=replace-me
OAUTH_GITHUB_CLIENT_SECRET=replace-me
OAUTH_GITHUB_REDIRECT_URI=https://your-domain.example.com/api/auth/github/callback
LANGFUSE_ENABLED=false
AGENT_MAX_CONCURRENT_RUNS=8
NACOS_SERVER_ADDR=47.95.192.221
NACOS_PASSWORD=2005525a
