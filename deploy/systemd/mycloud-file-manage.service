[Unit]
Description=myCloud File Manage Service (8084) — 列表/新建文件夹/重命名/移动/复制/收藏/回收站
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/opt/mycloud/.env
WorkingDirectory=/opt/mycloud
ExecStart=/usr/bin/java \
  -Xms128m -Xmx192m \
  -XX:+UseG1GC -XX:MaxGCPauseMillis=200 \
  -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/opt/mycloud/logs \
  -jar /opt/mycloud/file-manage-service-1.0-SNAPSHOT.jar
Restart=on-failure
RestartSec=10
StandardOutput=append:/opt/mycloud/logs/file-manage-service.log
StandardError=append:/opt/mycloud/logs/file-manage-service.log

[Install]
WantedBy=multi-user.target