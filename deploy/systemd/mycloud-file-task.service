[Unit]
Description=myCloud File Task Service (8091) — 定时任务:上传超时/分享过期/打包清理/回收站清理
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/opt/mycloud/.env
WorkingDirectory=/opt/mycloud
ExecStart=/usr/bin/java \
  -Xms128m -Xmx192m \
  -XX:+UseG1GC -XX:MaxGCPauseMillis=200 \
  -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/opt/mycloud/logs \
  -jar /opt/mycloud/file-task-service-1.0-SNAPSHOT.jar
Restart=on-failure
RestartSec=10
StandardOutput=append:/opt/mycloud/logs/file-task-service.log
StandardError=append:/opt/mycloud/logs/file-task-service.log

[Install]
WantedBy=multi-user.target