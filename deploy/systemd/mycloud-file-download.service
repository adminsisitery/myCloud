[Unit]
Description=myCloud File Download Service (8083) — 单文件流式下载/文件夹同步ZIP/打包
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/opt/mycloud/.env
WorkingDirectory=/opt/mycloud
ExecStart=/usr/bin/java \
  -Xms128m -Xmx192m \
  -XX:+UseG1GC -XX:MaxGCPauseMillis=200 \
  -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/opt/mycloud/logs \
  -jar /opt/mycloud/file-download-service-1.0-SNAPSHOT.jar
Restart=on-failure
RestartSec=10
StandardOutput=append:/opt/mycloud/logs/file-download-service.log
StandardError=append:/opt/mycloud/logs/file-download-service.log

[Install]
WantedBy=multi-user.target