[Unit]
Description=myCloud Gateway (8090) — Spring Cloud Gateway 入口
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/opt/mycloud/.env
WorkingDirectory=/opt/mycloud
ExecStart=/usr/bin/java \
  -Xms128m -Xmx192m \
  -XX:+UseG1GC -XX:MaxGCPauseMillis=200 \
  -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/opt/mycloud/logs \
  -jar /opt/mycloud/pan-gateway-1.0-SNAPSHOT.jar
Restart=on-failure
RestartSec=10
StandardOutput=append:/opt/mycloud/logs/gateway.log
StandardError=append:/opt/mycloud/logs/gateway.log

[Install]
WantedBy=multi-user.target