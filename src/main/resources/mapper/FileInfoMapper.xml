<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ff.mycloud.repositorys.FileInfoMapper">


    <select id="findOverTimeFile" resultType="java.lang.Long">
        SELECT id
        FROM t_file_info
        WHERE isDeleted = 1
          AND deletedAt &lt; #{thirtyDayAgo}
    </select>
</mapper>