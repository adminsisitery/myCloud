<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ff.mycloud.ai.mapper.AiMessageMapper">

    <select id="findByMsgId" resultType="com.ff.mycloud.ai.model.entity.AiMessages">
        SELECT * FROM t_ai_message WHERE conversation_id = #{memId} ORDER BY create_time ASC
    </select>

    <delete id="deleteByCId">
        DELETE FROM t_ai_message WHERE conversation_id = #{CId}
    </delete>

</mapper>
