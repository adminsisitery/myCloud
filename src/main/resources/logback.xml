<?xml version="1.0" encoding="UTF-8"?>
<configuration scan ="true" scanPeriod="60 seconds" debug="false">

    <property name="LOG_HISTORY" value="30"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} [traceId=%X{traceId:-none}] - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 【文件按天滚动Appender，核心】 -->
    <appender name="FILE_DAILY" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- 当前正在写的日志文件名 -->
        <file>${LOG_PATH}/business.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- 滚动后的文件名，%d按天 yyyy-MM-dd -->
            <fileNamePattern>${LOG_PATH}/business.%d{yyyy-MM-dd}.log</fileNamePattern>
            <!-- 保留30天日志，超过自动删除 -->
            <maxHistory>${LOG_HISTORY}</maxHistory>
            <!-- 可选：总日志文件上限，超出也会删旧文件，防止磁盘打满 -->
            <totalSizeCap>10GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} [traceId=%X{traceId:-none}] - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 【单独ERROR日志文件，关键业务错误单独落文件（可选）】 -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/business-error.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/business-error.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>${LOG_HISTORY}</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} [traceId=%X{traceId:-none}] - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <!-- 过滤器：只记录ERROR级别，WARN/INFO等全部过滤掉 -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>

    <!-- 根logger，全局日志级别 -->
    <logger name="com.ff.mycloud" level="${MYCLOUD_LOG_LEVEL:-INFO}"/>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE_DAILY"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>
</configuration>